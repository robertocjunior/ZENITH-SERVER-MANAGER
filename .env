# ==============================================================================
# ZENITH SERVER MANAGER — CONFIGURAÇÃO CENTRAL (.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Configurações do VictoriaMetrics (TSDB)
# ------------------------------------------------------------------------------
# Porta exposta do VictoriaMetrics no host
VM_PORT=8428
# Período de retenção de métricas (ex: 30d, 90d, 1y)
VM_RETENTION_PERIOD=30d

# ------------------------------------------------------------------------------
# 2. Conexão com o Servidor Windows TOTVS Protheus (Agentless: WinRM / WMI)
# ------------------------------------------------------------------------------
# IP ou Hostname do Servidor Windows Protheus
ZENITH_TARGET_HOST=127.0.0.1
# Porta WinRM (5985 para HTTP ou 5986 para HTTPS)
ZENITH_TARGET_WINRM_PORT=5985
# Habilitar HTTPS no WinRM
ZENITH_TARGET_WINRM_HTTPS=false
# Aceitar certificados autoassinados (insecure TLS)
ZENITH_TARGET_WINRM_INSECURE=true
# Usuário de serviço com permissão WMI/WinRM e SMB
ZENITH_TARGET_USERNAME=Administrator
# Senha do usuário de serviço
ZENITH_TARGET_PASSWORD=""
# Domínio do Active Directory (opcional)
ZENITH_TARGET_DOMAIN=""

# ------------------------------------------------------------------------------
# 3. Compartilhamento SMB2 & Logs Remotos do TOTVS Protheus
# ------------------------------------------------------------------------------
# Compartilhamento administrativo SMB (ex: C$)
ZENITH_TARGET_SMB_SHARE="C$"
# Caminho relativo ao share do console.log do AppServer
ZENITH_TARGET_APPSERVER_LOG="totvs/protheus/bin/appserver/console.log"
# Caminho relativo ao share do log do DBAccess
ZENITH_TARGET_DBACCESS_LOG="totvs/dbaccess/dbaccess.log"

# ------------------------------------------------------------------------------
# 4. Portas TCP dos Serviços Protheus a Monitorar
# ------------------------------------------------------------------------------
ZENITH_TARGET_TCP_PORTS="AppServer - Principal:1234,DBAccess - TopConnect:7890,TOTVS License Server:5555"

# ------------------------------------------------------------------------------
# 5. Modo de Operação do Coletor
# true  = Emulador/Mock de alta fidelidade (testes sem servidor Windows)
# false = Coleta real agentless no servidor Windows Protheus
# ------------------------------------------------------------------------------
ZENITH_MOCK_MODE=true

# ------------------------------------------------------------------------------
# 6. Ingestão de Séries Temporais no TSDB
# ------------------------------------------------------------------------------
ZENITH_TSDB_URL="http://victoriametrics:8428"
ZENITH_TSDB_BATCH_SIZE=250
ZENITH_TSDB_FLUSH_INTERVAL=2s
ZENITH_TSDB_MAX_BUFFER_SIZE=25000

# ------------------------------------------------------------------------------
# 7. Servidor Web & Dashboard
# ------------------------------------------------------------------------------
ZENITH_PORT=8080
ZENITH_LISTEN_ADDR=":8080"
ZENITH_AUTH_USERNAME=admin
ZENITH_AUTH_PASSWORD="zenith@2026"
ZENITH_AUTH_TOKEN=""
